{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --port 4181 --strictPort",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4181/",
        "http://localhost:4181/how"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop",
        "skipAudits": [
          "uses-http2"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 900000
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
