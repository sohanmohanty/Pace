{
  "name": "pace",
  "private": true,
  "type": "module",
  "description": "A planner that plans around how you actually feel. Capacity-aware daily planning for students coming back from a disruption.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "evals": "vitest run --config vitest.evals.config.ts",
    "lighthouse": "npm run build && lhci autorun",
    "check": "npm run typecheck && npm test && npm run evals"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "cmdk": "^1.1.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.525.0",
    "motion": "^14.0.0",
    "openai": "^7.28.0",
    "react": "^19.1.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4"
  }
}
